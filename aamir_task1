#include<iostream>
using namespace std;
int main(){
    int arr[5] = {3,6,9,15,25};
        int max = arr[0];
    int min = arr[0];  

    for(int i = 1; i < 5; i++){
        if(arr[i] > max){
            max = arr[i];
        }
        if(arr[i] < min){
            min = arr[i];
        }
    }
    cout << "Maxi = " << max << endl;
         cout << "Mini= " << min << endl;
    cout << "Reverse Array: ";
      for(int i = 4; i >= 0; i--){
        cout << arr[i] << " ";
    }

    return 0;
}

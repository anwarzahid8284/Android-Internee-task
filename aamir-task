#include<iostream>
using namespace std;

int main(){

    int num, rever = 0, rem, origi;

    cout << "Enter Num: ";
    cin >> num;

    origi = num;

    while(num != 0){
    rem = num % 10;
   rever = rever * 10 + rem;

        num = num / 10;
    }
    if(origi == rever){
        cout << "Palindrome";
    }
    else{
        cout << "Not Palindrome";
    }

    return 0;
}
